<section class="rm-shop-hero">
 <div class="rm-shop-copy"><p class="rm-eyebrow">{{ 'recast.hero.eyebrow' | t }}</p><h1>{{ section.settings.heading | escape }}</h1><p class="rm-intro">{{ 'recast.hero.intro' | t }}</p><a class="rm-action" href="https://recastmeai.com/#start">{{ 'recast.nav.start' | t }} <span aria-hidden="true">↗</span></a><p class="rm-caption">{{ 'recast.hero.caption' | t }}</p></div>
 <figure class="rm-hero-art"><img src="https://recastmeai.com/assets/hero-your-world-v08.webp" width="1024" height="1024" alt="{{ 'recast.hero.alt' | t | escape }}" loading="eager"><figcaption>{{ 'recast.hero.art_label' | t }}</figcaption></figure>
</section>
<div class="rm-steps" aria-label="{{ 'recast.steps.label' | t | escape }}"><p><span>01</span>{{ 'recast.steps.photo' | t }}</p><p><span>02</span>{{ 'recast.steps.world' | t }}</p><p><span>03</span>{{ 'recast.steps.product' | t }}</p></div>
<section class="rm-shop-products"><div class="rm-section-heading"><p class="rm-eyebrow">{{ 'recast.products.eyebrow' | t }}</p><h2>{{ 'recast.products.heading' | t }}</h2><p>{{ 'recast.products.note' | t }}</p></div><div class="rm-product-grid">
{% paginate collections.all.products by 36 %}
{% for item in collections.all.products %}<article class="rm-product-card"><a href="{{ item.url }}">{% if item.featured_image %}{{ item.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', class: 'rm-product-image' }}{% endif %}<div class="rm-product-copy"><h3>{{ item.title | escape }}</h3><p>{{ 'recast.products.from' | t }} {{ item.price_min | money }}</p><span>{{ 'recast.products.explore' | t }} <span aria-hidden="true">→</span></span></div></a></article>{% endfor %}
{{ paginate | default_pagination }}
{% endpaginate %}
</div></section>
<section class="rm-gift-banner"><p class="rm-eyebrow">{{ 'recast.gift.eyebrow' | t }}</p><h2>{{ 'recast.gift.heading' | t }}</h2><p>{{ 'recast.gift.copy' | t }}</p><a href="https://recastmeai.com/support">{{ 'recast.gift.link' | t }} →</a></section>
{% stylesheet %}
.rm-shop-hero,.rm-shop-products,.rm-gift-banner,.rm-steps{max-width:1256px;margin:auto}.rm-shop-hero{display:grid;grid-template-columns:1.05fr 1fr;gap:64px;align-items:center;padding:72px 32px 56px}.rm-eyebrow{color:#b5a3f8;font-size:12px;font-weight:750;letter-spacing:.22em;text-transform:uppercase}.rm-shop-copy h1{font-size:clamp(42px,5.8vw,78px);line-height:1.02;letter-spacing:-.055em;margin:22px 0}.rm-intro{color:#bebccc;font-size:19px;line-height:1.65;max-width:470px}.rm-action{display:inline-flex;gap:50px;align-items:center;margin-top:22px;padding:19px 25px;border-radius:16px;background:linear-gradient(100deg,#913df2,#456aef,#26bddc);color:white;text-decoration:none;font-weight:750}.rm-caption{color:#aaa5ba;font-size:13px;margin-top:18px}.rm-hero-art{margin:0;position:relative;border:1px solid #51446f;border-radius:28px;overflow:hidden;box-shadow:0 24px 100px #6d39de22}.rm-hero-art img{display:block;width:100%;height:auto;aspect-ratio:4/5;object-fit:cover}.rm-hero-art figcaption{position:absolute;bottom:14px;left:16px;padding:7px 12px;border-radius:20px;background:#080914d9;font-size:12px;color:#ded8ed}.rm-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:30px;padding:26px 32px;border-block:1px solid #302443}.rm-steps p{margin:0;color:#e9e5f1;font-size:14px}.rm-steps span{color:#70d5e8;margin-right:14px}.rm-shop-products{padding:80px 32px}.rm-section-heading{max-width:720px;margin-bottom:34px}.rm-section-heading h2,.rm-gift-banner h2{font-size:clamp(30px,4vw,48px);letter-spacing:-.035em;line-height:1.1;margin:16px 0}.rm-section-heading>p:last-child,.rm-gift-banner>p{color:#b9b5c8;line-height:1.7}.rm-product-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.rm-product-card{border:1px solid #3a2e53;border-radius:22px;overflow:hidden;background:#111020}.rm-product-card>a{display:block;text-decoration:none;color:#f6f4fa}.rm-product-image{width:100%;aspect-ratio:1;object-fit:contain;background:#12101d;display:block}.rm-product-copy{padding:24px}.rm-product-copy h3{font-size:20px;line-height:1.25;margin:0 0 12px}.rm-product-copy p{color:#beb7cb;font-size:15px}.rm-product-copy>span{display:flex;justify-content:space-between;color:#8adcee;font-size:14px;font-weight:650}.rm-product-card:hover{border-color:#7d65b4}.rm-gift-banner{padding:48px;background:linear-gradient(120deg,#201439,#0b1929);border:1px solid #493661;border-radius:26px;margin-bottom:70px}.rm-gift-banner a{color:#8ee1ef}.rm-shop-hero a:focus-visible,.rm-product-card a:focus-visible{outline:3px solid #6cdded;outline-offset:4px}@media(max-width:850px){.rm-shop-hero{gap:30px}.rm-product-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.rm-shop-hero{grid-template-columns:1fr;padding:40px 20px;gap:32px}.rm-shop-copy h1{font-size:48px}.rm-hero-art img{aspect-ratio:1;object-position:center}.rm-steps{gap:18px;padding:22px 20px}.rm-steps span{display:block;margin:0 0 8px}.rm-steps p{font-size:12px}.rm-shop-products{padding:50px 20px}.rm-product-grid{gap:14px}.rm-product-copy{padding:16px}.rm-product-copy h3{font-size:16px}.rm-product-copy p,.rm-product-copy>span{font-size:12px}.rm-gift-banner{margin:0 20px 50px;padding:28px}}
{% endstylesheet %}
{% schema %}
{"name":"Recast showcase","settings":[{"type":"text","id":"heading","label":"Heading","default":"Your world. Recast."}],"presets":[{"name":"Recast showcase"}]}
{% endschema %}
