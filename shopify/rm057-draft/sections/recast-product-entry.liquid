<section class="rm-product-entry"><div class="rm-entry-media">{% for media in product.images limit: 4 %}{{ media | image_url: width: 1200 | image_tag: loading: 'lazy' }}{% endfor %}<p>{{ 'recast.products.note' | t }}</p></div><div class="rm-entry-details"><p class="rm-entry-kicker">{{ 'recast.product.eyebrow' | t }}</p><h1>{{ product.title | escape }}</h1><p class="rm-entry-price">{{ 'recast.products.from' | t }} {{ product.price_min | money }}</p><div class="rte">{{ product.description }}</div><div class="rm-entry-instructions"><h2>{{ 'recast.product.heading' | t }}</h2><p>{{ 'recast.product.instructions' | t }}</p><a href="https://recastmeai.com/#start">{{ 'recast.product.cta' | t }} ↗</a><p>{{ 'recast.product.saved' | t }}</p></div><details><summary>{{ 'recast.product.options' | t }}</summary><ul>{% for variant in product.variants %}<li>{{ variant.title | escape }} — {{ variant.price | money }}</li>{% endfor %}</ul></details><details><summary>{{ 'recast.gift.heading' | t }}</summary><p>{{ 'recast.gift.copy' | t }}</p></details></div></section>
{% stylesheet %}
.rm-product-entry{max-width:1220px;margin:auto;padding:56px 32px;display:grid;grid-template-columns:1.1fr 1fr;gap:56px}.rm-entry-media img{width:100%;height:auto;object-fit:contain;border:1px solid #3d3055;border-radius:22px;margin-bottom:20px}.rm-entry-media p{font-size:13px;color:#b3adbf;line-height:1.65}.rm-entry-kicker{color:#b6a3f8;text-transform:uppercase;letter-spacing:.18em;font-size:12px}.rm-entry-details h1{font-size:clamp(32px,4vw,48px);letter-spacing:-.035em;line-height:1.1}.rm-entry-price{font-size:23px;color:#8fe0ee}.rm-entry-details .rte{color:#c6c0d1;line-height:1.7}.rm-entry-instructions{padding:24px;border:1px solid #51416f;border-radius:18px;background:#19142a;margin:28px 0}.rm-entry-instructions h2{font-size:22px;line-height:1.2}.rm-entry-instructions p{color:#c4bcd2;font-size:14px;line-height:1.7}.rm-entry-instructions a{display:block;text-align:center;padding:17px;border-radius:14px;color:#fff;text-decoration:none;font-weight:700;background:linear-gradient(100deg,#833deb,#3678db,#25afce)}.rm-entry-details details{border-top:1px solid #3a2d50;padding:20px 0;line-height:1.7}.rm-entry-details summary{cursor:pointer;font-weight:650}.rm-entry-details a:focus-visible{outline:3px solid #7dddff;outline-offset:4px}@media(max-width:700px){.rm-product-entry{grid-template-columns:1fr;padding:30px 20px;gap:26px}}
{% endstylesheet %}
{% schema %}
{"name":"Recast product entry","settings":[],"presets":[{"name":"Recast product entry"}]}
{% endschema %}
