{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "recast-me",
  "main": "./src/router.js",
  "compatibility_date": "2026-09-23",
  "keep_vars": true,
  "vars": {
    "SHOPIFY_CLIENT_ID": "34095311ef89068f873eb42bfba8e597",
    "SHOPIFY_SHOP": "b2wnfu-7g",
    "IMAGE_MODEL_PRIMARY": "@cf/black-forest-labs/flux-2-dev",
    "IMAGE_MODEL_FALLBACK": "@cf/black-forest-labs/flux-2-klein-4b",
    "IMAGE_PREVIEW_STEPS": "20"
  },
  "ai": {
    "binding": "AI"
  },
  "r2_buckets": [
    {
      "binding": "ARTWORK",
      "bucket_name": "recast-me-artwork"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}