{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "recast-me",
  "main": "./src/router.js",
  "compatibility_date": "2026-09-23",
  "keep_vars": true,
  "secrets": {
    "required": ["PRINTFUL_API_TOKEN"]
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "vars": {
    "SHOPIFY_CLIENT_ID": "34095311ef89068f873eb42bfba8e597",
    "SHOPIFY_SHOP": "b2wnfu-7g",
    "PRINTFUL_STORE_ID": "18798877",
    "PUBLIC_APP_URL": "https://recastmeai.com",
    "LIVE_APP_URL": "https://recastmeai.com",
    "IMAGE_MODEL_HIGH_QUALITY": "@cf/black-forest-labs/flux-2-dev",
    "IMAGE_MODEL_QUICK": "@cf/black-forest-labs/flux-2-klein-9b",
    "IMAGE_MODEL_SOCIAL": "@cf/black-forest-labs/flux-2-klein-4b",
    "RENDER_CREDITS_ENABLED": "true",
    "CREDIT_PACKS_ENABLED": "true",
    "CREDIT_SALES_ENABLED": "false",
    "CREDIT_TEST_CHECKOUT_ENABLED": "true",
    "RENDER_CREDITS_STORAGE_SALT": "true",
    "HQ_FREE_ALLOWANCE": "3",
    "STANDARD_FREE_ALLOWANCE": "5",
    "PURCHASE_BONUS": "3",
    "AI_DAILY_SOCIAL_CALL_LIMIT": "100",
    "AI_STANDARD_RESERVE_CENTS": "3",
    "AI_SOCIAL_RESERVE_CENTS": "1",
    "IMAGE_HIGH_QUALITY_STEPS": "18",
    "IMAGE_HIGH_QUALITY_GUIDANCE": "5",
    "IMAGE_QUICK_GUIDANCE": "5",
    "IMAGE_QUICK_STEPS": "12",
    "AI_DAILY_CALL_LIMIT": "70",
    "AI_DAILY_BUDGET_CENTS": "500",
    "AI_CALL_RESERVE_CENTS": "7",
    "RECAST_HQ_PROVIDER": "fal",
    "FAL_OWNER_TEST_ENABLED": "true",
    "FAL_PROVIDER_ENABLED": "true",
    "FAL_PROVIDER_VERIFIED": "true",
    "CF_PROVIDER_VERIFIED": "false",
    "ALERT_EMAIL_PROVIDER": "gmail",
    "ORDER_SYNC_ENABLED": "true",
    "AUTO_PRINT_PREAPPROVED_ENABLED": "true",
    "X_BOT_ENABLED": "false",
    "X_USERNAME": "recastmeai",
    "X_BOT_APPROVED": "false",
    "X_RENDER_BATCH_SIZE": "2",
    "TREND_SCANNER_ENABLED": "false",
    "RETENTION_CLEANUP_ENABLED": "false",
    "UNPAID_RETENTION_DAYS": "30",
    "RENDER_CAPACITY_COOLDOWN_SECONDS": "90",
    "RENDER_QUOTA_COOLDOWN_SECONDS": "300",
    "RENDER_TIMEOUT_COOLDOWN_SECONDS": "300",
    "RENDER_UNAVAILABLE_COOLDOWN_SECONDS": "60"
  },
  "ai": {
    "binding": "AI"
  },
  "images": { "binding": "IMAGES" },
  "ratelimits": [
    {
      "name": "RENDER_RATE_LIMITER",
      "namespace_id": "5301",
      "simple": { "limit": 8, "period": 60 }
    }
  ],
  "previews": {
    "vars": {
      "PRINTFUL_STORE_ID": "18798877",
      "SHOPIFY_CLIENT_ID": "34095311ef89068f873eb42bfba8e597",
      "SHOPIFY_SHOP": "b2wnfu-7g",
      "PUBLIC_APP_URL": "https://recast-secure-previews-2026-09-29-recast-me.sergz24.workers.dev",
      "LIVE_APP_URL": "https://recastmeai.com"
    },
    "ai": {
      "binding": "AI"
    },
    "images": {
      "binding": "IMAGES"
    },
    "r2_buckets": [
      {
        "binding": "ARTWORK",
        "bucket_name": "recast-me-artwork"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "ARTWORK",
      "bucket_name": "recast-me-artwork"
    }
  ],
  "triggers": {
    "crons": ["* * * * *", "*/10 * * * *"]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/proof/*"]
  }

  // Preserve the existing production Images binding during controlled testing.
}
