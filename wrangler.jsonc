{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "recast-me",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-23",
  "ai": {
    "binding": "AI"
  },
  "r2_buckets": [
    {
      "binding": "ARTWORK",
      "bucket_name": "recast-me-artwork"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
