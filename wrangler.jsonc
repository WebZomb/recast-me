{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "recast-me",
  "main": "./src/router.js",
  "compatibility_date": "2026-09-23",
  "keep_vars": true,
  "vars": {
    "SHOPIFY_CLIENT_ID": "34095311ef89068f873eb42bfba8e597",
    "SHOPIFY_SHOP": "b2wnfu-7g",
    "PRINTFUL_STORE_ID": "18798877",
    "PUBLIC_APP_URL": "https://recast-me.sergz24.workers.dev",
    "IMAGE_MODEL_HIGH_QUALITY": "@cf/black-forest-labs/flux-2-dev",
    "IMAGE_MODEL_QUICK": "@cf/black-forest-labs/flux-2-klein-9b",
    "IMAGE_HIGH_QUALITY_STEPS": "18",
    "IMAGE_HIGH_QUALITY_GUIDANCE": "5",
    "IMAGE_QUICK_GUIDANCE": "4",
    "ORDER_SYNC_ENABLED": "false",
    "X_BOT_ENABLED": "false",
    "X_BOT_APPROVED": "false",
    "TREND_SCANNER_ENABLED": "false",
    "RETENTION_CLEANUP_ENABLED": "false",
    "UNPAID_RETENTION_DAYS": "30"
  },
  "ai": {
    "binding": "AI"
  },
  "r2_buckets": [
    {
      "binding": "ARTWORK",
      "bucket_name": "recast-me-artwork"
    }
  ],
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }

  // Add the Cloudflare Images binding only when you are ready to enable
  // billable high-resolution print finishing:
  // "images": { "binding": "IMAGES" }
}
